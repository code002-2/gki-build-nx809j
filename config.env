# gki-build-nx809j 默认配置
# 全部可被同名环境变量或命令行参数覆盖(H:\nubia\android 下直接改这里)

# ============ 内核目标(固定 6.12) ============
ANDROID_VERSION="android16"
KERNEL_VERSION="6.12"

# 安全补丁级别(即内核源): auto=自动选最新月度发布 | tip=分支头(最新代码) |
#   lts=LTS 分支 | 具体月份如 2026-09 / 2026-06 / 2026-03 / 2025-12 ...
PATCH_LEVEL="auto"

# ============ KernelSU ============
# Official | ReSukiSU | SukiSU | Next
# 注意: SukiSU 最新版目前不兼容 6.12, 建议 Official 或 ReSukiSU
KSU_VARIANT="Official"

# 自定义版本名(可选, 显示在 uname -r / 编译版本里)
VERSION_NAME=""

# 自定义构建时间(伪装 UTS_VERSION), 形如 "Sun Dec 01 08:10:00 UTC 2024"; 留空=当前时间
BUILD_TIME=""

# KPM 功能: disabled | enabled | patched(开启并修补, 上游尚未支持)
USE_KPM="disabled"

# Droidspaces 容器支持: off | on (6.12 只有开关)
DROIDSPACES="off"
# Droidspaces + NTSync 支持(需 DROIDSPACES=on)
DROIDSPACES_NTSYNC="false"

# 产物模式: all=全部(内核+3种boot镜像+AnyKernel3) | anykernel3=仅 AnyKernel3.zip
ARTIFACT_MODE="all"

# ============ 功能开关 ============
USE_ZRAM="false"          # ZRAM 增强(6.12 上游未适配, 选择后会自动跳过)
USE_BBG="false"           # BBG 防格机
USE_REKERNEL="false"      # Re-Kernel 驱动
CVE_2026_43499_PATCH="false"  # 应用 CVE-2026-43499/53163 rtmutex 修复链(内置)
CANCEL_SUSFS="false"      # true = 禁用 SUSFS
SUPP_OP="false"           # 启用一加 8E 支持

# ============ 构建环境 ============
MIRROR="ustc"             # ustc | google | nju (Actions 里固定传 --mirror google)
SLIM="true"               # 精简 sync, 跳过 GBL 相关项目
WITH_MANAGER="false"      # 构建后下载管理器 APK
CLEAN="false"             # 构建前清理 work/
#JOBS="8"                 # repo sync 并发, 默认 nproc
