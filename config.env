# gki-build-nx809j 默认配置
# 都可以用命令行参数(注意参数优先)或同名环境变量覆盖

# 内核目标(Android 16 GKI 6.12)
ANDROID_VERSION="android16"
KERNEL_VERSION="6.12"

# KernelSU 变体: Official | ReSukiSU | SukiSU | Next
# 提示: SukiSU 最新版目前不兼容 6.12, 建议 Official 或 ReSukiSU
KSU_VARIANT="Official"

# 内核源
#   release = 最新的月度 GKI 发布分支(官方发布, 推荐)
#   tip     = android16-6.12 分支头(最新代码, 如 6.12.92)
SOURCE_MODE="release"

# 下载镜像: ustc(中科大, 国内快) | google(官方) | nju(南大)
# GitHub Actions 里会自动传 --mirror google
MIRROR="ustc"

# 集成 SUSFS
ENABLE_SUSFS="true"

# 精简同步: 跳过 GBL(引导加载器)相关项目, 省约 10GB 磁盘
# 若后续构建报缺项目, 设为 false 使用完整同步
SLIM="true"

# 构建后顺便下载对应 KernelSU 变体的管理器 APK
WITH_MANAGER="false"

# 上次构建产物目录清理
CLEAN="false"

# 自定义构建时间(伪装 UTS_VERSION), 格式如 "Mon Oct 13 12:00:00 UTC 2025"
# 留空 = 当前时间
BUILD_TIME=""

# repo sync 并发数, 留空 = nproc
#JOBS="8"
