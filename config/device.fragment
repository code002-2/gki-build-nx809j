# NX809J (红魔 11) 设备配置补充
# 来源: 设备内核 6.12.23 (固件 BQ2A.250705.001) /proc/config.gz vs 构建产物 kernel.config
#   首次对比(设备 vs GKI 基线)后加入: 4K 页 / F2FS 压缩 / DM_USER / ZRAM lzo-rle
#   二次对比(设备 vs 解析后真实 config)后加入:
#     AF_UNIX_OOB / BLK_WBT_MQ / STREAM_PARSER / TLS=m
#   注: ANDROID_STAGING / ASHMEM_RUST 在 6.12.23 存在但在 6.12.81 Kconfig 中已移除,
#       klint 校验会报未知配置, 故不加入 (由设备侧 dlkm 处理)
#   (HAVE_FUNCTION_GRAPH_RETVAL 为编译器自动推导, 不手动设置)
CONFIG_ARM64_4K_PAGES=y

CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y

CONFIG_DM_USER=y

CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y

CONFIG_AF_UNIX_OOB=y
CONFIG_BLK_WBT_MQ=y
CONFIG_STREAM_PARSER=y
CONFIG_TLS=m

